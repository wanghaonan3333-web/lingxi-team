{
  "id": "lingxi-team",
  "name": "灵犀团队助手",
  "description": "在 Octo 群与子区按当前发言人连接灵犀，不授权整个群。",
  "contracts": {
    "tools": [
      "lingxi_team_read",
      "lingxi_bind"
    ]
  },
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "url": {
        "type": "string",
        "description": "管理员配置的灵犀站点地址"
      },
      "agentId": {
        "type": "string",
        "description": "本企业专用 Agent ID，成员无须配置"
      },
      "hostKeyFile": {
        "type": "string",
        "description": "本机 0600 主机密钥文件的绝对路径"
      }
    }
  }
}
